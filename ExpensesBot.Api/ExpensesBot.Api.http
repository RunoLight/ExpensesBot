# Requests for local development. The API accepts the X-Dev-User-Id header
# only when running with ASPNETCORE_ENVIRONMENT=Development.

@host = http://localhost:5069
@devUser = 123456789

GET {{host}}/health

###

GET {{host}}/api/v1/profile
X-Dev-User-Id: {{devUser}}

###

GET {{host}}/api/v1/categories
X-Dev-User-Id: {{devUser}}

###

POST {{host}}/api/v1/transactions
X-Dev-User-Id: {{devUser}}
Content-Type: application/json

{
  "amountMinor": 150000,
  "currency": "AMD",
  "categoryId": null,
  "note": "Groceries",
  "type": 0
}

###

GET {{host}}/api/v1/transactions?limit=20
X-Dev-User-Id: {{devUser}}

###

GET {{host}}/api/v1/transactions/summary?mode=month&currency=AMD
X-Dev-User-Id: {{devUser}}

###

GET {{host}}/api/v1/exchange/rates
