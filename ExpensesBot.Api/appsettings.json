{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ExpensesDatabase": "Data Source=data/expenses.db"
  },
  "Telegram": {
    "BotToken": "",
    "InitDataMaxAgeHours": 24
  },
  "RateLimiting": {
    "TokenLimit": 60,
    "TokensPerMinute": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "https://runolight.github.io"
    ]
  }
}
