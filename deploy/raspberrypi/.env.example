# /opt/expensesbot/.env on the Pi (chmod 600, never committed).
TELEGRAM_BOT_TOKEN=
# Origin the Mini App is served from (CORS).
CLIENT_ORIGIN=https://runolight.github.io
# URL the bot's "Open app" buttons point to.
WEBAPP_URL=https://runolight.github.io/ExpensesBot/
# Pin a build by commit SHA instead of following master, e.g. to roll back.
IMAGE_TAG=latest
