@page "/"
@using System.Globalization

<PageTitle>@T.AppTitle</PageTitle>

<div class="expenses-app @(darkTheme ? "dark" : null)">
    <div class="app-shell">
        <AppHeader Currency="@currency"
                   OnHelp="() => dialog = Dialog.Help"
                   OnProfile="() => dialog = Dialog.Profile" />

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <ErrorBanner Message="@error" OnDismiss="() => error = null" />
        }

        @if (loading)
        {
            <p class="muted">@T.Loading</p>
        }
        else
        {
            <SummaryCard Summary="summary"
                         SummaryMode="@summaryMode"
                         Month="summaryMonth"
                         Loading="summaryLoading"
                         OnModeChanged="ChangeSummaryModeAsync"
                         OnMonthChanged="ChangeSummaryMonthAsync" />

            <TransactionForm Form="form"
                             Categories="categories"
                             Tags="tags"
                             Wallets="wallets"
                             SelectedTagIds="selectedTagIds"
                             Saving="saving"
                             OnSubmit="AddTransactionAsync"
                             OnToggleTag="ToggleTagSelection"
                             OnAddTag="AddTagAsync"
                             OnUpdateTag="UpdateTagAsync"
                             OnDeleteTag="DeleteTagAsync" />

            <TabBar Items="Tabs()" Selected="@tab" Label="@T.Sections" OnSelected="value => tab = value" />

            @switch (tab)
            {
                case TabCharts:
                    <CategoryBreakdown CategoryRows="summary.ByCategory" PeriodRows="summary.ByPeriod" Categories="categories" />
                    @if (summary.ByCategory.Count == 0)
                    {
                        <EmptyState Icon="📊" Title="@T.NoChartData">
                            <p>@T.NoChartDataHint</p>
                        </EmptyState>
                    }
                    break;

                case TabPlanning:
                    <Budgets Items="budgets"
                             Categories="categories"
                             Saving="saving"
                             OnCreate="AddBudgetAsync"
                             OnUpdate="UpdateBudgetAsync"
                             OnDelete="DeleteBudgetAsync" />

                    <Goals Items="goals"
                           Categories="categories"
                           Saving="saving"
                           OnCreate="AddGoalAsync"
                           OnUpdate="UpdateGoalAsync"
                           OnContribute="ContributeToGoalAsync"
                           OnDelete="DeleteGoalAsync" />

                    <RecurringTransactions Items="recurringTransactions"
                                           Categories="categories"
                                           Saving="saving"
                                           OnCreate="AddRecurringAsync"
                                           OnUpdate="UpdateRecurringAsync"
                                           OnExecute="ExecuteRecurringAsync"
                                           OnDelete="DeleteRecurringAsync" />
                    break;

                case TabManage:
                    <CategoryManager Categories="categories"
                                     Saving="saving"
                                     OnCreate="AddCategoryAsync"
                                     OnUpdate="UpdateCategoryAsync"
                                     OnArchive="ArchiveCategoryAsync"
                                     OnDelete="DeleteCategoryAsync" />

                    <Wallets Items="wallets"
                             Saving="saving"
                             BotUsername="@botUsername"
                             OnCreate="CreateWalletAsync"
                             OnJoin="JoinWalletAsync"
                             LoadView="LoadWalletViewAsync"
                             OnRegenerateInvite="RegenerateWalletInviteAsync"
                             OnRemoveMember="RemoveWalletMemberAsync"
                             OnLeave="LeaveWalletAsync"
                             OnDelete="DeleteWalletAsync" />
                    break;

                default:
                    <TransactionList Transactions="transactions"
                                     Filter="historyFilter"
                                     HasMore="hasMoreTransactions"
                                     LoadingMore="loadingMoreTransactions"
                                     OnFilterChanged="ChangeHistoryFilterAsync"
                                     OnLoadMore="LoadMoreTransactionsAsync"
                                     Categories="categories"
                                     Tags="tags"
                                     Wallets="wallets"
                                     Rates="rates"
                                     SelectedCurrency="@currency"
                                     Saving="saving"
                                     OnRefresh="RefreshAsync"
                                     OnEdit="OpenEdit"
                                     OnDelete="DeleteTransactionAsync" />
                    break;
            }
        }
    </div>

    @switch (dialog)
    {
        case Dialog.Help:
            <HelpModal OnClose="CloseDialog" />
            break;

        case Dialog.Profile:
            <ProfileModal Currency="@currency"
                          DarkTheme="darkTheme"
                          Saving="saving"
                          OnCurrencyChanged="ChangeCurrencyAsync"
                          OnLanguageChanged="ChangeLanguageAsync"
                          OnToggleTheme="ToggleThemeAsync"
                          OnImport="() => dialog = Dialog.Import"
                          OnExport="ExportCsvAsync"
                          OnDeleteAccount="() => dialog = Dialog.DeleteAccount"
                          OnClose="CloseDialog" />
            break;

        case Dialog.Import:
            <ImportModal Categories="categories" OnClose="CloseDialog" OnImported="ReloadTransactionDataAsync" />
            break;

        case Dialog.DeleteAccount:
            <DeleteAccountModal Saving="saving" OnConfirm="DeleteAccountAsync" OnClose="CloseDialog" />
            break;

        case Dialog.Edit when editing is not null:
            <EditModal Form="editForm"
                       Categories="categories"
                       Tags="tags"
                       Saving="saving"
                       OnSave="SaveEditAsync"
                       OnClose="CloseDialog" />
            break;
    }
</div>

@code {
    private const string ThemeStorageKey = "expensesTheme";

    // Sections under the add form; the history is the default.
    private const string TabHistory = "history";
    private const string TabCharts = "charts";
    private const string TabPlanning = "planning";
    private const string TabManage = "manage";

    private enum Dialog { None, Help, Profile, Import, DeleteAccount, Edit }

    [CascadingParameter] public UiText T { get; set; } = UiText.En;

    [Inject] private ExpensesApiClient Api { get; set; } = null!;
    [Inject] private LanguageState Language { get; set; } = null!;
    [Inject] private TelegramService Telegram { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;
    [Inject] private Microsoft.Extensions.Configuration.IConfiguration Configuration { get; set; } = null!;

    // Data
    private List<CategoryDto> categories = [];
    private List<TransactionDto> transactions = [];
    private HistoryFilter historyFilter = new();
    private bool hasMoreTransactions;
    private bool loadingMoreTransactions;
    private int historyRequest;
    private List<RecurringTransactionDto> recurringTransactions = [];
    private List<BudgetDto> budgets = [];
    private List<GoalDto> goals = [];
    private List<TagDto> tags = [];
    private List<ExchangeRateDto> rates = [];
    private List<WalletDto> wallets = [];
    private UserSummaryDto summary = UserSummaryDto.Empty("AMD");

    // View state
    private bool loading = true;
    private bool saving;
    private string? error;
    private string currency = "AMD";
    private string summaryMode = "month";
    private DateTime summaryMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private bool summaryLoading;
    private int summaryRequest;
    private bool darkTheme;
    private Dialog dialog;
    private string tab = TabHistory;
    private string? botUsername;

    // New transaction form and the transaction being edited
    private TransactionFormModel form = new();
    private readonly HashSet<long> selectedTagIds = [];
    private TransactionFormModel editForm = new();
    private TransactionDto? editing;

    protected override async Task OnInitializedAsync()
    {
        await TryJsAsync(async () => await Telegram.ReadyAsync());
        await LoadThemeAsync();

        // Until the profile arrives, speak the language of the user's Telegram app.
        await TryJsAsync(async () => Language.Set(UiText.LanguageFromTelegram(await Telegram.GetLanguageCodeAsync())));
        await ApplyStartParameterAsync();
        botUsername = Configuration["BotUsername"];

        try
        {
            var profile = await Api.GetProfileAsync();
            currency = profile.DefaultCurrency;
            form.Currency = currency;
            Language.Set(profile.Language);
        }
        catch (Exception ex)
        {
            error = T.WithReason(T.ErrorLoadProfile, ex);
        }

        await LoadAsync();

        // After the first load, which clears the error banner, so a failed join stays visible.
        if (await JoinWalletFromStartParameterAsync())
            wallets = await Api.GetWalletsAsync();
    }

    /// <summary>
    /// Reloads all data. Only the first load shows the placeholder: later reloads keep
    /// the panels mounted, so open forms and history filters survive a refresh.
    /// </summary>
    private async Task LoadAsync()
    {
        error = null;

        try
        {
            // Requests are independent, so run them in parallel.
            var categoriesTask = Api.GetCategoriesAsync();
            var historyVersion = ++historyRequest;
            var transactionsTask = Api.GetTransactionsAsync(historyFilter);
            var summaryVersion = ++summaryRequest;
            var summaryTask = Api.GetSummaryAsync(summaryMode, currency, summaryMonth);
            var recurringTask = Api.GetRecurringTransactionsAsync();
            var budgetsTask = Api.GetBudgetsAsync();
            var goalsTask = Api.GetGoalsAsync();
            var tagsTask = Api.GetTagsAsync();
            var ratesTask = Api.GetExchangeRatesAsync();
            var walletsTask = Api.GetWalletsAsync();

            await Task.WhenAll(categoriesTask, transactionsTask, summaryTask, recurringTask,
                budgetsTask, goalsTask, tagsTask, ratesTask, walletsTask);

            categories = categoriesTask.Result;
            if (historyVersion == historyRequest)
                SetFirstPage(transactionsTask.Result);
            if (summaryVersion == summaryRequest)
                summary = summaryTask.Result;
            recurringTransactions = recurringTask.Result;
            budgets = budgetsTask.Result;
            goals = goalsTask.Result;
            tags = tagsTask.Result;
            rates = ratesTask.Result;
            wallets = walletsTask.Result;

            // The wallet picked in the form may have been left or deleted.
            if (form.WalletId is { } walletId && wallets.All(w => w.Id != walletId))
                form.WalletId = null;
        }
        catch (Exception ex)
        {
            error = T.WithReason(T.ErrorLoadData, ex);
        }
        finally
        {
            loading = false;
        }
    }

    private Task RefreshAsync() => RunAsync(LoadAsync, T.ErrorRefresh);

    private (string Value, string Label)[] Tabs() =>
    [
        (TabHistory, T.History),
        (TabCharts, T.Charts),
        (TabPlanning, T.Planning),
        (TabManage, T.Manage)
    ];

    // Targeted reloads: after a change, ask only for what it can affect.

    /// <summary>
    /// After transactions change: the history, the summary and what is computed from
    /// transactions (budget spending, goal savings). Categories, tags, wallets and rates stay.
    /// </summary>
    private Task ReloadTransactionDataAsync() =>
        Task.WhenAll(ReloadHistoryAsync(), ReloadSummaryAsync(), ReloadBudgetsAndGoalsAsync());

    private async Task ReloadBudgetsAndGoalsAsync()
    {
        var budgetsTask = Api.GetBudgetsAsync();
        var goalsTask = Api.GetGoalsAsync();
        await Task.WhenAll(budgetsTask, goalsTask);

        budgets = budgetsTask.Result;
        goals = goalsTask.Result;
    }

    private async Task ReloadRecurringAsync() =>
        recurringTransactions = await Api.GetRecurringTransactionsAsync();

    private async Task ReloadWalletsAndHistoryAsync()
    {
        var walletsTask = Api.GetWalletsAsync();
        await Task.WhenAll(walletsTask, ReloadHistoryAsync());

        wallets = walletsTask.Result;
        if (form.WalletId is { } walletId && wallets.All(w => w.Id != walletId))
            form.WalletId = null;
    }

    /// <summary>
    /// Reloads only the summary. Responses for a period the user has already
    /// switched away from are dropped, so quick taps never show stale totals.
    /// </summary>
    private async Task ReloadSummaryAsync()
    {
        var request = ++summaryRequest;
        summaryLoading = true;

        try
        {
            var result = await Api.GetSummaryAsync(summaryMode, currency, summaryMonth);
            if (request == summaryRequest)
                summary = result;
        }
        catch (Exception ex)
        {
            if (request == summaryRequest)
                error = T.WithReason(T.ErrorRefreshSummary, ex);
        }
        finally
        {
            if (request == summaryRequest)
                summaryLoading = false;
        }
    }

    // History

    private void SetFirstPage(List<TransactionDto> page)
    {
        transactions = page;
        hasMoreTransactions = page.Count == HistoryFilter.PageSize;
    }

    /// <summary>Reloads the first page; answers for a filter the user has already changed are dropped.</summary>
    private async Task ReloadHistoryAsync()
    {
        var request = ++historyRequest;

        try
        {
            var page = await Api.GetTransactionsAsync(historyFilter);
            if (request == historyRequest)
                SetFirstPage(page);
        }
        catch (Exception ex)
        {
            if (request == historyRequest)
                error = T.WithReason(T.ErrorRefresh, ex);
        }
    }

    private Task ChangeHistoryFilterAsync(HistoryFilter filter)
    {
        historyFilter = filter;
        return ReloadHistoryAsync();
    }

    private async Task LoadMoreTransactionsAsync()
    {
        var request = historyRequest;
        loadingMoreTransactions = true;

        try
        {
            var page = await Api.GetTransactionsAsync(historyFilter, offset: transactions.Count);
            if (request != historyRequest)
                return;

            // A transaction added meanwhile shifts the pages: skip what is already shown.
            transactions = [.. transactions, .. page.Where(t => transactions.All(shown => shown.Id != t.Id))];
            hasMoreTransactions = page.Count == HistoryFilter.PageSize;
        }
        catch (Exception ex)
        {
            error = T.WithReason(T.ErrorRefresh, ex);
        }
        finally
        {
            loadingMoreTransactions = false;
        }
    }

    private Task ChangeSummaryMonthAsync(DateTime month)
    {
        summaryMonth = month;
        return ReloadSummaryAsync();
    }

    private Task ChangeSummaryModeAsync(string mode)
    {
        if (mode == summaryMode)
            return Task.CompletedTask;

        summaryMode = mode;
        return ReloadSummaryAsync();
    }

    /// <summary>The header currency is the profile's default: the bot records and reports in it.</summary>
    private Task ChangeCurrencyAsync(string value) =>
        RunAsync(async () =>
        {
            await Api.SetDefaultCurrencyAsync(value);
            currency = value;
            form.Currency = value;
            await ReloadSummaryAsync();
        }, T.ErrorChangeCurrency);

    /// <summary>The language is saved in the profile: the bot and notifications use it too.</summary>
    private Task ChangeLanguageAsync(string language) =>
        RunAsync(async () =>
        {
            await Api.SetLanguageAsync(language);
            Language.Set(language);
        }, T.ErrorChangeLanguage);

    private void CloseDialog()
    {
        dialog = Dialog.None;
        editing = null;
    }

    // Transactions

    private async Task AddTransactionAsync()
    {
        if (!TryGetAmount(form.Amount, out var amountMinor))
            return;

        await RunAsync(async () =>
        {
            await Api.CreateTransactionAsync(
                amountMinor, form.Currency, form.CategoryId, form.Note, form.Type,
                selectedTagIds.Count > 0 ? selectedTagIds.ToList() : null,
                form.WalletId,
                form.IdempotencyKey,
                form.OccurredAtUtcFor());

            selectedTagIds.Clear();
            form = new TransactionFormModel { Currency = form.Currency, Type = form.Type, WalletId = form.WalletId };
            await ReloadTransactionDataAsync();
        }, T.ErrorSaveTransaction);
    }

    private void OpenEdit(TransactionDto transaction)
    {
        editing = transaction;
        editForm = new TransactionFormModel
        {
            Amount = transaction.AmountMinor / 100.0,
            Currency = transaction.Currency,
            CategoryId = transaction.CategoryId,
            Note = transaction.Note,
            Type = transaction.Type,
            Date = transaction.OccurredAtUtc.ToLocalTime().Date,
            TagIds = transaction.TransactionTags?.Select(tt => tt.TagId).ToHashSet() ?? []
        };
        dialog = Dialog.Edit;
    }

    private async Task SaveEditAsync()
    {
        if (editing is not { } original || !TryGetAmount(editForm.Amount, out var amountMinor))
            return;

        await RunAsync(async () =>
        {
            await Api.UpdateTransactionAsync(
                original.Id, amountMinor, editForm.Currency, editForm.CategoryId, editForm.Note, editForm.Type,
                editForm.OccurredAtUtcFor(original.OccurredAtUtc), editForm.TagIds);

            CloseDialog();
            await ReloadTransactionDataAsync();
        }, T.ErrorUpdateTransaction);
    }

    private Task DeleteTransactionAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.DeleteTransactionAsync(id);
            await ReloadTransactionDataAsync();
        }, T.ErrorDeleteTransaction);

    private Task ExportCsvAsync() =>
        RunAsync(async () =>
        {
            var bytes = await Api.ExportCsvAsync();
            if (bytes.Length > 0)
                await JS.InvokeVoidAsync("expensesUtils.downloadCsv", bytes, $"expenses_{DateTime.Now:yyyyMMdd}.csv");
        }, T.ErrorExport);

    // Recurring transactions

    private async Task<bool> AddRecurringAsync(RecurringTransactionForm rule)
    {
        if (!TryGetAmount(rule.Amount, out var amountMinor))
            return false;

        return await RunAsync(async () =>
        {
            await Api.CreateRecurringTransactionAsync(
                amountMinor, rule.Currency, rule.CategoryId, rule.Note, rule.Pattern, rule.Type);
            recurringTransactions = await Api.GetRecurringTransactionsAsync();
        }, T.ErrorCreateRecurring);
    }

    private async Task<bool> UpdateRecurringAsync(long id, RecurringTransactionForm rule)
    {
        if (!TryGetAmount(rule.Amount, out var amountMinor))
            return false;

        return await RunAsync(async () =>
        {
            var updated = await Api.UpdateRecurringTransactionAsync(
                id, amountMinor, rule.Currency, rule.CategoryId, rule.Note, rule.Pattern, rule.Type);
            var index = recurringTransactions.FindIndex(r => r.Id == id);
            if (index >= 0)
                recurringTransactions[index] = updated;
        }, T.ErrorUpdateRecurring);
    }

    private Task ExecuteRecurringAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.ExecuteRecurringTransactionAsync(id);
            await Task.WhenAll(ReloadTransactionDataAsync(), ReloadRecurringAsync());
        }, T.ErrorRunRecurring);

    private Task DeleteRecurringAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.DeleteRecurringTransactionAsync(id);
            recurringTransactions.RemoveAll(r => r.Id == id);
        }, T.ErrorDelete);

    // Categories

    private async Task<bool> AddCategoryAsync(NewCategoryForm category)
    {
        if (string.IsNullOrWhiteSpace(category.Name))
        {
            error = T.EnterCategoryName;
            return false;
        }

        return await RunAsync(
            async () => categories.Add(await Api.CreateCategoryAsync(category.Name, category.Icon)),
            T.ErrorCreateCategory);
    }

    private async Task<bool> UpdateCategoryAsync(long id, NewCategoryForm category)
    {
        if (string.IsNullOrWhiteSpace(category.Name))
        {
            error = T.EnterCategoryName;
            return false;
        }

        return await RunAsync(async () =>
        {
            var updated = await Api.UpdateCategoryAsync(id, category.Name, category.Icon);
            var index = categories.FindIndex(c => c.Id == id);
            if (index >= 0)
                categories[index] = updated;

            // The history, the summary, budgets, goals and rules carry the category name.
            await Task.WhenAll(ReloadTransactionDataAsync(), ReloadRecurringAsync());
        }, T.ErrorUpdateCategory);
    }

    private Task DeleteCategoryAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.DeleteCategoryAsync(id);
            categories.RemoveAll(c => c.Id == id);

            // Its transactions, budgets, goals and rules lose the category.
            await Task.WhenAll(ReloadTransactionDataAsync(), ReloadRecurringAsync());
        }, T.ErrorDeleteCategory);

    private Task ArchiveCategoryAsync(long id) =>
        RunAsync(async () =>
        {
            var updated = await Api.ArchiveCategoryAsync(id);
            var index = categories.FindIndex(c => c.Id == id);
            if (index >= 0)
                categories[index] = updated;
        }, T.ErrorArchive);

    // Budgets and goals

    private async Task<bool> AddBudgetAsync(BudgetForm budget)
    {
        if (!TryValidateBudget(budget, out var amountMinor))
            return false;

        return await RunAsync(async () =>
        {
            await Api.CreateBudgetAsync(
                amountMinor, budget.Currency, budget.CategoryId,
                BudgetStartUtc(budget), BudgetEndUtc(budget));
            budgets = await Api.GetBudgetsAsync();
        }, T.ErrorCreateBudget);
    }

    private async Task<bool> UpdateBudgetAsync(long id, BudgetForm budget)
    {
        if (!TryValidateBudget(budget, out var amountMinor))
            return false;

        return await RunAsync(async () =>
        {
            await Api.UpdateBudgetAsync(
                id, amountMinor, budget.Currency, budget.CategoryId,
                BudgetStartUtc(budget), BudgetEndUtc(budget));
            budgets = await Api.GetBudgetsAsync();
        }, T.ErrorUpdateBudget);
    }

    private bool TryValidateBudget(BudgetForm budget, out long amountMinor)
    {
        if (!TryGetAmount(budget.Amount, out amountMinor))
            return false;

        if (budget.EndDate <= budget.StartDate)
        {
            error = T.EndAfterStart;
            return false;
        }

        return true;
    }

    // A budget covers whole days: from the start of the first to the end of the last.
    private static DateTime BudgetStartUtc(BudgetForm budget) =>
        DateTime.SpecifyKind(budget.StartDate.Date, DateTimeKind.Utc);

    private static DateTime BudgetEndUtc(BudgetForm budget) =>
        DateTime.SpecifyKind(budget.EndDate.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc);

    private Task DeleteBudgetAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.DeleteBudgetAsync(id);
            budgets.RemoveAll(b => b.Id == id);
        }, T.ErrorDeleteBudget);

    private async Task<bool> AddGoalAsync(GoalForm goal)
    {
        if (string.IsNullOrWhiteSpace(goal.Name))
        {
            error = T.EnterGoalName;
            return false;
        }

        if (!TryGetAmount(goal.TargetAmount, out var amountMinor))
            return false;

        return await RunAsync(async () =>
        {
            await Api.CreateGoalAsync(goal.Name, amountMinor, goal.Currency, goal.CategoryId, goal.TargetDate);

            // A goal without a category gets its own one, so refresh both.
            goals = await Api.GetGoalsAsync();
            categories = await Api.GetCategoriesAsync();
        }, T.ErrorCreateGoal);
    }

    private async Task<bool> UpdateGoalAsync(long id, GoalForm goal)
    {
        if (string.IsNullOrWhiteSpace(goal.Name))
        {
            error = T.EnterGoalName;
            return false;
        }

        if (!TryGetAmount(goal.TargetAmount, out var amountMinor))
            return false;

        return await RunAsync(async () =>
        {
            var updated = await Api.UpdateGoalAsync(id, goal.Name, amountMinor, goal.TargetDate);
            var index = goals.FindIndex(g => g.Id == id);
            if (index >= 0)
                goals[index] = updated;
        }, T.ErrorUpdateGoal);
    }

    private Task DeleteGoalAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.DeleteGoalAsync(id);
            goals.RemoveAll(g => g.Id == id);
        }, T.ErrorDeleteGoal);

    private Task ContributeToGoalAsync(GoalContribution contribution) =>
        RunAsync(async () =>
        {
            await Api.ContributeToGoalAsync(contribution.GoalId, contribution.AmountMinor);
            await ReloadTransactionDataAsync();
        }, T.ErrorContribute);

    // Tags

    private void ToggleTagSelection(long tagId)
    {
        if (!selectedTagIds.Remove(tagId))
            selectedTagIds.Add(tagId);
    }

    private async Task AddTagAsync(NewTagForm tag)
    {
        if (string.IsNullOrWhiteSpace(tag.Name))
        {
            error = T.EnterTagName;
            return;
        }

        await RunAsync(async () => tags.Add(await Api.CreateTagAsync(tag.Name, tag.Color)), T.ErrorCreateTag);
    }

    private async Task<bool> UpdateTagAsync(TagEdit edit)
    {
        if (string.IsNullOrWhiteSpace(edit.Form.Name))
        {
            error = T.EnterTagName;
            return false;
        }

        return await RunAsync(async () =>
        {
            var updated = await Api.UpdateTagAsync(edit.Id, edit.Form.Name, edit.Form.Color);
            var index = tags.FindIndex(t => t.Id == edit.Id);
            if (index >= 0)
                tags[index] = updated;
        }, T.ErrorUpdateTag);
    }

    private Task DeleteTagAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.DeleteTagAsync(id);
            tags.RemoveAll(t => t.Id == id);
            selectedTagIds.Remove(id);
        }, T.ErrorDeleteTag);

    // Shared wallets

    private async Task<bool> CreateWalletAsync(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            error = T.EnterWalletName;
            return false;
        }

        return await RunAsync(async () =>
        {
            await Api.CreateWalletAsync(name);
            wallets = await Api.GetWalletsAsync();
        }, T.ErrorCreateWallet);
    }

    private async Task<bool> JoinWalletAsync(string code)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            error = T.EnterInviteCode;
            return false;
        }

        return await RunAsync(async () =>
        {
            await Api.JoinWalletAsync(code);
            wallets = await Api.GetWalletsAsync();
        }, T.ErrorJoin);
    }

    private async Task<WalletView?> LoadWalletViewAsync(long id)
    {
        try
        {
            return await Api.GetWalletViewAsync(id, currency);
        }
        catch (Exception ex)
        {
            error = T.WithReason(T.ErrorLoadWallet, ex);
            StateHasChanged();
            return null;
        }
    }

    private Task<bool> RegenerateWalletInviteAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.RegenerateWalletInviteAsync(id);
            wallets = await Api.GetWalletsAsync();
        }, T.ErrorRegenerate);

    private Task<bool> RemoveWalletMemberAsync(WalletMemberRemoval removal) =>
        RunAsync(async () =>
        {
            await Api.RemoveWalletMemberAsync(removal.WalletId, removal.UserId);
            wallets = await Api.GetWalletsAsync();
        }, T.ErrorRemoveMember);

    private Task LeaveWalletAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.LeaveWalletAsync(id);
            await ReloadWalletsAndHistoryAsync();
        }, T.ErrorLeave);

    private Task DeleteWalletAsync(long id) =>
        RunAsync(async () =>
        {
            await Api.DeleteWalletAsync(id);
            await ReloadWalletsAndHistoryAsync();
        }, T.ErrorDeleteWallet);

    /// <summary>Opens the app through t.me/your_bot/app?startapp=join_ABCD2345: joins that wallet.</summary>
    private async Task<bool> JoinWalletFromStartParameterAsync()
    {
        string? inviteCode = null;
        await TryJsAsync(async () => inviteCode = await Telegram.GetStartParamAsync("join"));

        if (string.IsNullOrWhiteSpace(inviteCode))
            return false;

        try
        {
            await Api.JoinWalletAsync(inviteCode);
            return true;
        }
        catch (Exception ex)
        {
            error = T.WithReason(T.ErrorJoinFromLink, ex);
            return false;
        }
    }

    // Account

    private Task DeleteAccountAsync() =>
        RunAsync(async () =>
        {
            await Api.DeleteAccountAsync();
            CloseDialog();

            // The next request creates a fresh account with default categories.
            currency = (await Api.GetProfileAsync()).DefaultCurrency;
            await LoadAsync();
        }, T.ErrorDeleteAccount);

    // Theme and Telegram integration

    private async Task LoadThemeAsync()
    {
        string? saved = null;
        await TryJsAsync(async () => saved = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeStorageKey));

        if (saved is "dark" or "light")
            darkTheme = saved == "dark";
        else
            // No explicit choice yet: follow the Telegram colour scheme.
            await TryJsAsync(async () => darkTheme = await Telegram.IsDarkThemeAsync());

        await TryJsAsync(async () => await Telegram.ApplyThemeAsync(darkTheme));
    }

    private async Task ToggleThemeAsync()
    {
        darkTheme = !darkTheme;
        await TryJsAsync(async () => await JS.InvokeVoidAsync("localStorage.setItem", ThemeStorageKey, darkTheme ? "dark" : "light"));
        await TryJsAsync(async () => await Telegram.ApplyThemeAsync(darkTheme));
    }

    /// <summary>
    /// Supports deep links like t.me/your_bot/app?startapp=expense_1500_Lunch
    /// to open the app with the amount (and optionally a note) pre-filled.
    /// Telegram only allows A-Z, a-z, 0-9, "_" and "-" in startapp.
    /// </summary>
    private async Task ApplyStartParameterAsync()
    {
        string? startParam = null;
        await TryJsAsync(async () => startParam = await Telegram.GetStartParamAsync("expense"));

        if (string.IsNullOrWhiteSpace(startParam))
            return;

        var parts = startParam.Split('_', 2);
        if (decimal.TryParse(parts[0], NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) && amount > 0)
        {
            form.Amount = (double)amount;
            if (parts.Length == 2)
                form.Note = parts[1];
        }
    }

    // Helpers

    private bool TryGetAmount(double amount, out long amountMinor)
    {
        amountMinor = Money.ToMinor(amount);

        if (amountMinor <= 0)
        {
            error = T.AmountMustBePositive;
            return false;
        }

        if (amount > 1_000_000_000)
        {
            error = T.AmountTooLarge;
            return false;
        }

        error = null;
        return true;
    }

    /// <summary>
    /// Runs an API action with the saving flag set and shows errors in the banner.
    /// Child forms call some handlers through a plain Func (to learn whether saving
    /// succeeded), which does not re-render this page, hence the explicit StateHasChanged.
    /// </summary>
    private async Task<bool> RunAsync(Func<Task> action, string errorPrefix)
    {
        saving = true;
        error = null;
        StateHasChanged();

        try
        {
            await action();
            return true;
        }
        catch (Exception ex)
        {
            error = T.WithReason(errorPrefix, ex);
            return false;
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private static async Task TryJsAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (JSException)
        {
            // Not running inside Telegram or storage is unavailable.
        }
        catch (InvalidOperationException)
        {
            // JS interop not available (e.g. during prerendering or tests).
        }
    }
}
