@if (PeriodRows.Count > 0 || CategoryRows.Count > 0)
{
    <section class="panel">
        @if (PeriodRows.Count > 0)
        {
            var periods = PeriodRows.Where(p => !string.IsNullOrEmpty(p.Period)).Take(6).ToList();
            var maxPeriod = periods.Select(p => p.TotalAmountMinor).DefaultIfEmpty(0).Max();

            <h2>По периодам</h2>
            <div class="bar-chart">
                @foreach (var period in periods)
                {
                    <BarRow Label="@FormatPeriod(period.Period)"
                            Value="period.TotalAmountMinor"
                            Max="maxPeriod"
                            Amount="@($"{Money.Format(period.TotalAmountMinor)} {period.Currency}")" />
                }
            </div>
        }

        @if (CategoryRows.Count > 0)
        {
            var categories = CategoryRows.Take(8).ToList();
            var maxCategory = categories.Max(c => c.TotalAmountMinor);

            <h2>По категориям</h2>
            <div class="bar-chart">
                @foreach (var row in categories)
                {
                    <BarRow Label="@($"{Categories.IconFor(row.CategoryId)} {row.CategoryName}")"
                            Value="row.TotalAmountMinor"
                            Max="maxCategory"
                            Amount="@($"{Money.Format(row.TotalAmountMinor)} {row.Currency}")" />
                }
            </div>

            <h2>Структура расходов</h2>
            <PieChart Slices="Slices" />
        }
    </section>
}

@code {
    private static readonly string[] Palette =
        ["#FF6384", "#36A2EB", "#FFCE56", "#4BC0C0", "#9966FF", "#FF9F40", "#E7759A", "#C9CBCF", "#7BC67E", "#8C6D46"];

    private static readonly string[] MonthNames =
        ["Янв", "Фев", "Мар", "Апр", "Май", "Июн", "Июл", "Авг", "Сен", "Окт", "Ноя", "Дек"];

    [Parameter] public List<PeriodTotalDto> PeriodRows { get; set; } = [];
    [Parameter] public List<CategoryTotalDto> CategoryRows { get; set; } = [];
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];

    private List<PieChart.Slice> Slices =>
        CategoryRows
            .Take(Palette.Length)
            .Select((row, i) => new PieChart.Slice(row.CategoryName, row.TotalAmountMinor, Palette[i]))
            .ToList();

    /// <summary>"2026-10" → "Окт 2026".</summary>
    private static string FormatPeriod(string period)
    {
        var parts = period.Split('-');
        return parts.Length == 2 && int.TryParse(parts[1], out var month) && month is >= 1 and <= 12
            ? $"{MonthNames[month - 1]} {parts[0]}"
            : period;
    }
}
