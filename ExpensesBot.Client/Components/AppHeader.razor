<header class="app-header">
    <div>
        <div class="eyebrow">@T.AppEyebrow</div>
        <h1>@T.AppTitle</h1>
    </div>
    <div class="app-header__actions">
        <button type="button" class="btn-icon" title="@T.Help" aria-label="@T.Help" @onclick="OnHelp">❔</button>
        <button type="button" class="btn-icon btn-icon--text" title="@T.Profile" aria-label="@T.Profile" @onclick="OnProfile">
            👤 <span class="app-header__currency">@Currency</span>
        </button>
    </div>
</header>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;

    /// <summary>The main currency, shown on the profile button.</summary>
    [Parameter] public string Currency { get; set; } = "AMD";

    [Parameter] public EventCallback OnHelp { get; set; }

    /// <summary>Opens the profile: currency, language, theme, import/export, account deletion.</summary>
    [Parameter] public EventCallback OnProfile { get; set; }
}
