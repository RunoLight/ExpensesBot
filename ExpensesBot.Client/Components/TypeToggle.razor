<div class="type-toggle">
    <button type="button"
            class="@(Value == TransactionType.Expense ? "active expense" : null)"
            @onclick="() => SetAsync(TransactionType.Expense)">
        📉 @T.Expense
    </button>
    <button type="button"
            class="@(Value == TransactionType.Income ? "active income" : null)"
            @onclick="() => SetAsync(TransactionType.Income)">
        📈 @T.Income
    </button>
</div>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;
    [Parameter] public TransactionType Value { get; set; }
    [Parameter] public EventCallback<TransactionType> ValueChanged { get; set; }

    private Task SetAsync(TransactionType type) => ValueChanged.InvokeAsync(type);
}
