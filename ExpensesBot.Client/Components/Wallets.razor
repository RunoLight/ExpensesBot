<section class="panel">
    <PanelHeader Title="@T.Wallets" AddTitle="@T.CreateWallet" FormOpen="form == WalletForm.Create" OnToggleForm="() => Toggle(WalletForm.Create)">
        <button type="button"
                class="btn-icon @(form == WalletForm.Join ? "btn-icon--active" : null)"
                title="@T.JoinByCode"
                @onclick="() => Toggle(WalletForm.Join)">🔑</button>
    </PanelHeader>

    @if (form == WalletForm.Create)
    {
        <div class="wallet-form">
            <label for="wallet-name">@T.Name</label>
            <input id="wallet-name" class="form-control" placeholder="@T.WalletNamePlaceholder" @bind="name" />
            <button type="button" class="btn btn--primary" disabled="@Saving" @onclick="CreateAsync">@T.CreateWallet</button>
        </div>
    }
    else if (form == WalletForm.Join)
    {
        <div class="wallet-form">
            <label for="wallet-code">@T.InviteCode</label>
            <input id="wallet-code" class="form-control" placeholder="ABCD2345" @bind="code" />
            <button type="button" class="btn btn--primary" disabled="@Saving" @onclick="JoinAsync">@T.Join</button>
        </div>
    }

    @if (Items.Count == 0 && form == WalletForm.None)
    {
        <p class="muted">@T.WalletsIntro</p>
    }

    @foreach (var wallet in Items)
    {
        <article class="list-row" @key="wallet.Id">
            <span class="list-row__icon">👥</span>
            <div class="list-row__body">
                <strong>@wallet.Name</strong>
                <span class="list-row__meta">@T.Members(wallet.MemberCount) · @(wallet.IsOwner ? T.YouOwn : T.YouAreMember)</span>
            </div>
            <button type="button" class="btn-icon-textless btn-icon-textless--primary" @onclick="() => ToggleOpenAsync(wallet.Id)">
                @(openId == wallet.Id ? T.Hide : T.Open)
            </button>
        </article>

        @if (openId == wallet.Id)
        {
            <div class="wallet-details">
                @if (view is null)
                {
                    <p class="muted">@T.LoadingShort</p>
                }
                else
                {
                    var summary = view.Summary;

                    <div class="wallet-details__totals">
                        <span>@T.ThisMonthColon</span>
                        <span class="transaction-row__amount">−@Money.Format(summary.TotalExpenseMinor) @summary.Currency</span>
                        <span class="transaction-row__amount transaction-row__amount--income">+@Money.Format(summary.TotalIncomeMinor) @summary.Currency</span>
                    </div>
                    @if (summary.UsesFallbackRates)
                    {
                        <p class="warning-text">@T.WalletApproximateRates</p>
                    }

                    <h3 class="wallet-details__title">@T.MembersTitle</h3>
                    @foreach (var member in view.Details.Members)
                    {
                        var total = summary.ByMember.FirstOrDefault(x => x.UserId == member.UserId);
                        <div class="wallet-member">
                            <span>@member.DisplayName@(member.IsYou ? T.YouSuffix : "")@(member.Role == "Owner" ? T.OwnerSuffix : "")</span>
                            <span class="muted">−@Money.Format(total?.ExpenseMinor ?? 0) @summary.Currency</span>
                            @if (wallet.IsOwner && !member.IsYou)
                            {
                                <button type="button" class="btn-icon-textless btn-icon-textless--danger" title="@T.RemoveMember" @onclick="() => ConfirmAndRemoveAsync(wallet, member)">✕</button>
                            }
                        </div>
                    }

                    @if (summary.ByCategory.Count > 0)
                    {
                        <h3 class="wallet-details__title">@T.ExpensesByCategory</h3>
                        @foreach (var category in summary.ByCategory.Take(5))
                        {
                            <div class="wallet-member">
                                <span>@category.CategoryName</span>
                                <span class="muted">@Money.Format(category.ExpenseMinor) @summary.Currency</span>
                            </div>
                        }
                    }

                    @if (wallet.IsOwner && view.Details.InviteCode is { } inviteCode)
                    {
                        <h3 class="wallet-details__title">@T.Invitation</h3>
                        <p>
                            @T.CodeLabel <code class="wallet-code">@inviteCode</code>
                            <button type="button" class="btn-icon-textless btn-icon-textless--secondary" title="@T.NewCodeHint" @onclick="() => ConfirmAndRegenerateAsync(wallet)">@T.NewCode</button>
                        </p>
                        @if (InviteLink(inviteCode) is { } link)
                        {
                            <p class="muted">@T.InviteLinkLabel <a href="@link" target="_blank" rel="noopener">@link</a></p>
                        }
                        else
                        {
                            <p class="muted">@T.SendCodeBefore <code>@($"/start join_{inviteCode}")</code>.</p>
                        }
                    }

                    <h3 class="wallet-details__title">@T.LatestTransactions</h3>
                    @if (view.Transactions.Count == 0)
                    {
                        <p class="muted">@T.WalletEmpty</p>
                    }
                    @foreach (var transaction in view.Transactions)
                    {
                        <div class="wallet-member">
                            <span>
                                @(transaction.CategoryIcon ?? "📦") @(transaction.CategoryName ?? T.NoCategory)
                                <span class="muted">· @transaction.AuthorName@(string.IsNullOrWhiteSpace(transaction.Note) ? "" : $" · {transaction.Note}")</span>
                            </span>
                            <strong class="transaction-row__amount @(transaction.Type == TransactionType.Income ? "transaction-row__amount--income" : null)">
                                @Money.FormatSigned(transaction.AmountMinor, transaction.Currency, transaction.Type)
                            </strong>
                        </div>
                    }

                    <div class="wallet-details__actions">
                        @if (wallet.IsOwner)
                        {
                            <button type="button" class="btn btn--danger btn--small" disabled="@Saving" @onclick="() => ConfirmAndDeleteAsync(wallet)">@T.DeleteWallet</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn--secondary btn--small" disabled="@Saving" @onclick="() => ConfirmAndLeaveAsync(wallet)">@T.LeaveWallet</button>
                        }
                    </div>
                }
            </div>
        }
    }
</section>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;

    private enum WalletForm { None, Create, Join }

    [Parameter] public List<WalletDto> Items { get; set; } = [];
    [Parameter] public bool Saving { get; set; }

    /// <summary>Bot username for t.me invite links; without it only the code is shown.</summary>
    [Parameter] public string? BotUsername { get; set; }

    /// <summary>Creates a wallet with this name; true on success.</summary>
    [Parameter] public Func<string, Task<bool>> OnCreate { get; set; } = _ => Task.FromResult(false);

    /// <summary>Joins the wallet with this invite code; true on success.</summary>
    [Parameter] public Func<string, Task<bool>> OnJoin { get; set; } = _ => Task.FromResult(false);

    /// <summary>Loads members, summary and recent transactions of a wallet; null on error.</summary>
    [Parameter] public Func<long, Task<WalletView?>> LoadView { get; set; } = _ => Task.FromResult<WalletView?>(null);

    [Parameter] public Func<long, Task<bool>> OnRegenerateInvite { get; set; } = _ => Task.FromResult(false);
    [Parameter] public Func<WalletMemberRemoval, Task<bool>> OnRemoveMember { get; set; } = _ => Task.FromResult(false);
    [Parameter] public EventCallback<long> OnLeave { get; set; }
    [Parameter] public EventCallback<long> OnDelete { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private WalletForm form;
    private string name = "";
    private string code = "";
    private long? openId;
    private WalletView? view;

    private void Toggle(WalletForm kind) => form = form == kind ? WalletForm.None : kind;

    private async Task CreateAsync()
    {
        if (await OnCreate(name))
        {
            name = "";
            form = WalletForm.None;
        }
    }

    private async Task JoinAsync()
    {
        if (await OnJoin(code))
        {
            code = "";
            form = WalletForm.None;
        }
    }

    private async Task ToggleOpenAsync(long walletId)
    {
        if (openId == walletId)
        {
            openId = null;
            view = null;
            return;
        }

        openId = walletId;
        await ReloadViewAsync();
    }

    private async Task ReloadViewAsync()
    {
        if (openId is not { } walletId)
            return;

        view = null;
        var loaded = await LoadView(walletId);

        // The user may have opened another wallet meanwhile.
        if (openId == walletId)
            view = loaded;
    }

    private async Task ConfirmAndRegenerateAsync(WalletDto wallet)
    {
        if (await JS.ConfirmAsync(T.ConfirmRegenerate(wallet.Name)) &&
            await OnRegenerateInvite(wallet.Id))
        {
            await ReloadViewAsync();
        }
    }

    private async Task ConfirmAndRemoveAsync(WalletDto wallet, WalletMemberDto member)
    {
        var message = T.ConfirmRemoveMember(member.DisplayName, wallet.Name);
        if (await JS.ConfirmAsync(message) && await OnRemoveMember(new WalletMemberRemoval(wallet.Id, member.UserId)))
            await ReloadViewAsync();
    }

    private async Task ConfirmAndLeaveAsync(WalletDto wallet)
    {
        if (!await JS.ConfirmAsync(T.ConfirmLeave(wallet.Name)))
            return;

        openId = null;
        view = null;
        await OnLeave.InvokeAsync(wallet.Id);
    }

    private async Task ConfirmAndDeleteAsync(WalletDto wallet)
    {
        if (!await JS.ConfirmAsync(T.ConfirmDeleteWallet(wallet.Name)))
            return;

        openId = null;
        view = null;
        await OnDelete.InvokeAsync(wallet.Id);
    }

    private string? InviteLink(string inviteCode) =>
        string.IsNullOrWhiteSpace(BotUsername)
            ? null
            : $"https://t.me/{BotUsername.TrimStart('@')}?start=join_{inviteCode}";
}
