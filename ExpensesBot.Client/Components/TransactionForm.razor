<section class="panel">
    <EditForm Model="Form" OnValidSubmit="OnSubmit">
        <TypeToggle @bind-Value="Form.Type" />

        <div class="form-row">
            <div class="form-group">
                <label for="amount">@T.Amount</label>
                <InputNumber id="amount" class="form-control" @bind-Value="Form.Amount" />
            </div>
            <div class="form-group">
                <label for="currency">@T.Currency</label>
                <CurrencySelect Id="currency" @bind-Value="Form.Currency" />
            </div>
        </div>

        <label for="category">@T.Category</label>
        <CategorySelect Id="category" Categories="Categories" @bind-Value="Form.CategoryId" />

        @if (Wallets.Count > 0)
        {
            <label for="wallet">@T.RecordInto</label>
            <select id="wallet"
                    class="form-control"
                    value="@(Form.WalletId?.ToString() ?? "")"
                    @onchange="e => Form.WalletId = long.TryParse(e.Value?.ToString(), out var id) ? id : null">
                <option value="">@T.PersonalTransaction</option>
                @foreach (var wallet in Wallets)
                {
                    <option value="@wallet.Id">👥 @wallet.Name</option>
                }
            </select>
        }

        <label for="note">@T.Note</label>
        <InputText id="note" class="form-control" @bind-Value="Form.Note" placeholder="@T.NotePlaceholder" />

        <TagSelector Tags="Tags"
                     SelectedTagIds="SelectedTagIds"
                     Saving="Saving"
                     OnToggleTag="OnToggleTag"
                     OnAddTag="OnAddTag"
                     OnUpdateTag="OnUpdateTag"
                     OnDeleteTag="OnDeleteTag" />

        <button class="btn btn--primary" type="submit" disabled="@Saving">
            @(Saving ? T.Saving : Form.Type == TransactionType.Income ? T.AddIncome : T.AddExpense)
        </button>
    </EditForm>
</section>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;
    [Parameter, EditorRequired] public TransactionFormModel Form { get; set; } = new();
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];
    [Parameter] public List<TagDto> Tags { get; set; } = [];
    [Parameter] public List<WalletDto> Wallets { get; set; } = [];
    [Parameter] public HashSet<long> SelectedTagIds { get; set; } = [];
    [Parameter] public bool Saving { get; set; }

    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback<long> OnToggleTag { get; set; }
    [Parameter] public EventCallback<NewTagForm> OnAddTag { get; set; }
    [Parameter] public Func<TagEdit, Task<bool>> OnUpdateTag { get; set; } = _ => Task.FromResult(false);
    [Parameter] public EventCallback<long> OnDeleteTag { get; set; }
}
