<section class="panel">
    <PanelHeader Title="@T.Goals" AddTitle="@T.NewGoal" FormOpen="showForm" OnToggleForm="ToggleForm" />

    @foreach (var goal in Items.Where(g => g.IsActive))
    {
        <ProgressCard @key="goal.Id"
                      Title="@($"{goal.CategoryIcon ?? "🎯"} {goal.Name}")"
                      Amount="@($"{Money.Format(goal.SavedAmountMinor)} / {Money.Format(goal.TargetAmountMinor)} {goal.Currency}")"
                      Percent="goal.ProgressPercent"
                      Color="ColorFor(goal.ProgressPercent)"
                      OnEdit="() => StartEdit(goal)"
                      OnDelete="() => ConfirmAndDeleteAsync(goal)">
            <Footer>
                @if (goal.TargetDateUtc.HasValue)
                {
                    <span>@T.Until(goal.TargetDateUtc.Value)</span>
                }
            </Footer>
            <ChildContent>
                <div class="card__contribute">
                    <input type="number"
                           class="form-control"
                           min="0"
                           step="any"
                           placeholder="@T.AmountIn(goal.Currency)"
                           value="@DraftText(goal.Id)"
                           @onchange="e => SetContribution(goal.Id, e.Value)" />
                    <button type="button"
                            class="btn btn--small"
                            disabled="@(Saving || !contributions.ContainsKey(goal.Id))"
                            @onclick="() => ConfirmAndContributeAsync(goal)">@T.Contribute</button>
                </div>
            </ChildContent>
        </ProgressCard>
    }

    @if (showForm)
    {
        <EditForm Model="form" OnValidSubmit="SubmitAsync">
            <label for="goal-name">@T.GoalName</label>
            <InputText id="goal-name" class="form-control" @bind-Value="form.Name" placeholder="@T.GoalNamePlaceholder" />

            <div class="form-row">
                <div class="form-group">
                    <label for="goal-target">@T.TargetAmount</label>
                    <InputNumber id="goal-target" class="form-control" @bind-Value="form.TargetAmount" />
                </div>
                @if (editingId is null)
                {
                    <div class="form-group">
                        <label for="goal-currency">@T.Currency</label>
                        <CurrencySelect Id="goal-currency" @bind-Value="form.Currency" />
                    </div>
                }
            </div>

            @if (editingId is null)
            {
                <label for="goal-category">@T.Category</label>
                <CategorySelect Id="goal-category" Categories="Categories" EmptyLabel="@T.NewGoalCategory" @bind-Value="form.CategoryId" />
            }
            else
            {
                <p class="muted">@T.GoalFixedFields</p>
            }

            <label for="goal-date">@T.GoalDate</label>
            <InputDate id="goal-date" class="form-control" @bind-Value="form.TargetDate" />

            <button class="btn btn--primary" type="submit" disabled="@Saving">@(editingId is null ? T.CreateGoal : T.Save)</button>
        </EditForm>
    }
</section>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;
    [Parameter] public List<GoalDto> Items { get; set; } = [];
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];
    [Parameter] public bool Saving { get; set; }

    /// <summary>Saves the goal and returns true on success, so the form can reset.</summary>
    [Parameter] public Func<GoalForm, Task<bool>> OnCreate { get; set; } = _ => Task.FromResult(false);

    /// <summary>Saves the new name, target and date of the goal with the given id; true on success.</summary>
    [Parameter] public Func<long, GoalForm, Task<bool>> OnUpdate { get; set; } = (_, _) => Task.FromResult(false);
    [Parameter] public EventCallback<GoalContribution> OnContribute { get; set; }
    [Parameter] public EventCallback<long> OnDelete { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool showForm;
    private long? editingId;
    private GoalForm form = new();
    private readonly Dictionary<long, double> contributions = [];

    private void ToggleForm()
    {
        showForm = !showForm;
        editingId = null;
        form = new GoalForm { Currency = form.Currency };
    }

    private void StartEdit(GoalDto goal)
    {
        editingId = goal.Id;
        form = GoalForm.From(goal);
        showForm = true;
    }

    private async Task SubmitAsync()
    {
        var saved = editingId is { } id
            ? await OnUpdate(id, form)
            : await OnCreate(form);

        if (saved)
        {
            form = new GoalForm { Currency = form.Currency };
            editingId = null;
            showForm = false;
        }
    }

    private void SetContribution(long goalId, object? value)
    {
        if (double.TryParse(value?.ToString(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var amount) && amount > 0)
        {
            contributions[goalId] = amount;
        }
        else
        {
            contributions.Remove(goalId);
        }
    }

    private string DraftText(long goalId) =>
        contributions.TryGetValue(goalId, out var amount)
            ? amount.ToString(System.Globalization.CultureInfo.InvariantCulture)
            : "";

    private async Task ConfirmAndContributeAsync(GoalDto goal)
    {
        if (!contributions.TryGetValue(goal.Id, out var amount))
            return;

        var amountMinor = Money.ToMinor(amount);
        var message = T.ConfirmContribute($"{Money.Format(amountMinor)} {goal.Currency}", goal.Name);

        if (!await JS.ConfirmAsync(message))
            return;

        await OnContribute.InvokeAsync(new GoalContribution(goal.Id, amountMinor));
        contributions.Remove(goal.Id);
    }

    private async Task ConfirmAndDeleteAsync(GoalDto goal)
    {
        if (await JS.ConfirmAsync(T.ConfirmDeleteGoal(goal.Name)))
            await OnDelete.InvokeAsync(goal.Id);
    }

    private static ProgressBar.ProgressColor ColorFor(double percent) => percent switch
    {
        >= 90 => ProgressBar.ProgressColor.Success,
        >= 50 => ProgressBar.ProgressColor.Warning,
        _ => ProgressBar.ProgressColor.Info
    };
}
