<div class="panel-heading-row">
    <h2>@Title</h2>
    <div class="panel-heading-actions">
        @ChildContent
        @if (OnToggleForm.HasDelegate)
        {
            <button type="button" class="btn-icon" title="@(FormOpen ? T.Close : AddTitle ?? T.Add)" @onclick="OnToggleForm">
                @(FormOpen ? "✕" : "+")
            </button>
        }
    </div>
</div>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public bool FormOpen { get; set; }
    [Parameter] public string? AddTitle { get; set; }
    [Parameter] public EventCallback OnToggleForm { get; set; }

    /// <summary>Extra buttons placed before the add/close button.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
