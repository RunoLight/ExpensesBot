<section class="panel">
    <PanelHeader Title="Бюджеты" AddTitle="Новый бюджет" FormOpen="showForm" OnToggleForm="() => showForm = !showForm" />

    @foreach (var budget in Items)
    {
        <ProgressCard @key="budget.Id"
                      Title="@($"{budget.CategoryIcon ?? "💰"} {budget.CategoryName ?? "Общий"}")"
                      Amount="@($"{Money.Format(budget.SpentAmountMinor)} / {Money.Format(budget.AmountMinor)} {budget.Currency}")"
                      Percent="budget.ProgressPercent"
                      Color="ColorFor(budget.ProgressPercent)"
                      OnDelete="() => ConfirmAndDeleteAsync(budget)">
            <Footer>
                <span>@budget.StartDateUtc.ToString("dd.MM") – @budget.EndDateUtc.ToString("dd.MM.yyyy")</span>
                @if (budget.ProgressPercent >= 100)
                {
                    <span class="card__alert">⚠️ Превышен!</span>
                }
            </Footer>
        </ProgressCard>
    }

    @if (showForm)
    {
        <EditForm Model="form" OnValidSubmit="SubmitAsync">
            <div class="form-row">
                <div class="form-group">
                    <label for="budget-amount">Лимит</label>
                    <InputNumber id="budget-amount" class="form-control" @bind-Value="form.Amount" />
                </div>
                <div class="form-group">
                    <label for="budget-currency">Валюта</label>
                    <CurrencySelect Id="budget-currency" @bind-Value="form.Currency" />
                </div>
            </div>

            <label for="budget-category">Категория</label>
            <CategorySelect Id="budget-category" Categories="Categories" EmptyLabel="Общий (без категории)" @bind-Value="form.CategoryId" />

            <div class="form-row">
                <div class="form-group">
                    <label for="budget-start">С</label>
                    <InputDate id="budget-start" class="form-control" @bind-Value="form.StartDate" />
                </div>
                <div class="form-group">
                    <label for="budget-end">По</label>
                    <InputDate id="budget-end" class="form-control" @bind-Value="form.EndDate" />
                </div>
            </div>
            <button class="btn btn--primary" type="submit" disabled="@Saving">Создать бюджет</button>
        </EditForm>
    }
</section>

@code {
    [Parameter] public List<BudgetDto> Items { get; set; } = [];
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];
    [Parameter] public bool Saving { get; set; }

    /// <summary>Saves the budget and returns true on success, so the form can reset.</summary>
    [Parameter] public Func<BudgetForm, Task<bool>> OnCreate { get; set; } = _ => Task.FromResult(false);
    [Parameter] public EventCallback<long> OnDelete { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool showForm;
    private BudgetForm form = new();

    private async Task SubmitAsync()
    {
        if (await OnCreate(form))
        {
            form = new BudgetForm { Currency = form.Currency };
            showForm = false;
        }
    }

    private async Task ConfirmAndDeleteAsync(BudgetDto budget)
    {
        if (await JS.ConfirmAsync($"Удалить бюджет «{budget.CategoryName ?? "Общий"}»?"))
            await OnDelete.InvokeAsync(budget.Id);
    }

    private static ProgressBar.ProgressColor ColorFor(double percent) => percent switch
    {
        >= 90 => ProgressBar.ProgressColor.Danger,
        >= 70 => ProgressBar.ProgressColor.Warning,
        _ => ProgressBar.ProgressColor.Success
    };
}
