<section class="panel">
    <PanelHeader Title="@T.Budgets" AddTitle="@T.NewBudget" FormOpen="showForm" OnToggleForm="ToggleForm" />

    @foreach (var budget in Items)
    {
        <ProgressCard @key="budget.Id"
                      Title="@($"{budget.CategoryIcon ?? "💰"} {budget.CategoryName ?? T.OverallBudget}")"
                      Amount="@($"{Money.Format(budget.SpentAmountMinor)} / {Money.Format(budget.AmountMinor)} {budget.Currency}")"
                      Percent="budget.ProgressPercent"
                      Color="ColorFor(budget.ProgressPercent)"
                      OnEdit="() => StartEdit(budget)"
                      OnDelete="() => ConfirmAndDeleteAsync(budget)">
            <Footer>
                <span>@T.DateRange(budget.StartDateUtc, budget.EndDateUtc)</span>
                @if (budget.ProgressPercent >= 100)
                {
                    <span class="card__alert">@T.Exceeded</span>
                }
            </Footer>
        </ProgressCard>
    }

    @if (showForm)
    {
        <EditForm Model="form" OnValidSubmit="SubmitAsync">
            <div class="form-row">
                <div class="form-group">
                    <label for="budget-amount">@T.Limit</label>
                    <InputNumber id="budget-amount" class="form-control" @bind-Value="form.Amount" />
                </div>
                <div class="form-group">
                    <label for="budget-currency">@T.Currency</label>
                    <CurrencySelect Id="budget-currency" @bind-Value="form.Currency" />
                </div>
            </div>

            <label for="budget-category">@T.Category</label>
            <CategorySelect Id="budget-category" Categories="Categories" EmptyLabel="@T.OverallBudgetOption" @bind-Value="form.CategoryId" />

            <div class="form-row">
                <div class="form-group">
                    <label for="budget-start">@T.From</label>
                    <InputDate id="budget-start" class="form-control" @bind-Value="form.StartDate" />
                </div>
                <div class="form-group">
                    <label for="budget-end">@T.To</label>
                    <InputDate id="budget-end" class="form-control" @bind-Value="form.EndDate" />
                </div>
            </div>
            <button class="btn btn--primary" type="submit" disabled="@Saving">@(editingId is null ? T.CreateBudget : T.Save)</button>
        </EditForm>
    }
</section>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;
    [Parameter] public List<BudgetDto> Items { get; set; } = [];
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];
    [Parameter] public bool Saving { get; set; }

    /// <summary>Saves the budget and returns true on success, so the form can reset.</summary>
    [Parameter] public Func<BudgetForm, Task<bool>> OnCreate { get; set; } = _ => Task.FromResult(false);

    /// <summary>Saves changes to the budget with the given id; true on success.</summary>
    [Parameter] public Func<long, BudgetForm, Task<bool>> OnUpdate { get; set; } = (_, _) => Task.FromResult(false);
    [Parameter] public EventCallback<long> OnDelete { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool showForm;
    private long? editingId;
    private BudgetForm form = new();

    private void ToggleForm()
    {
        showForm = !showForm;
        editingId = null;
        form = new BudgetForm { Currency = form.Currency };
    }

    /// <summary>Opens the form with the budget's values; submitting saves instead of creating.</summary>
    private void StartEdit(BudgetDto budget)
    {
        editingId = budget.Id;
        form = BudgetForm.From(budget);
        showForm = true;
    }

    private async Task SubmitAsync()
    {
        var saved = editingId is { } id
            ? await OnUpdate(id, form)
            : await OnCreate(form);

        if (saved)
        {
            form = new BudgetForm { Currency = form.Currency };
            editingId = null;
            showForm = false;
        }
    }

    private async Task ConfirmAndDeleteAsync(BudgetDto budget)
    {
        if (await JS.ConfirmAsync(T.ConfirmDeleteBudget(budget.CategoryName ?? T.OverallBudget)))
            await OnDelete.InvokeAsync(budget.Id);
    }

    private static ProgressBar.ProgressColor ColorFor(double percent) => percent switch
    {
        >= 90 => ProgressBar.ProgressColor.Danger,
        >= 70 => ProgressBar.ProgressColor.Warning,
        _ => ProgressBar.ProgressColor.Success
    };
}
