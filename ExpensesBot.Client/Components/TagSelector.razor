<div>
    <div class="tag-selector__header">
        <span class="field-label">@T.Tags</span>
        <button type="button" class="btn-icon btn-icon--sm" title="@(showForm ? T.Close : T.NewTag)" @onclick="ToggleForm">
            @(showForm ? "✕" : "+")
        </button>
    </div>

    @if (showForm)
    {
        <div class="tag-selector__form">
            <div class="form-row form-row--inline">
                <div class="form-group">
                    <label for="tag-name">@T.Name</label>
                    <input id="tag-name" class="form-control" placeholder="@T.TagPlaceholder" @bind="newTag.Name" />
                </div>
                <button type="button" class="color-swatch" title="@T.ChangeColor" @onclick="() => newTag.Color = TagColors.Next(newTag.Color)">
                    <span style="background-color: @newTag.Color"></span>
                </button>
            </div>
            <button class="btn btn--primary" type="button" disabled="@Saving" @onclick="SubmitAsync">@(editingId is null ? T.AddTag : T.SaveTag)</button>
        </div>
    }

    @if (Tags.Count > 0)
    {
        <div class="tag-list">
            @foreach (var tag in Tags)
            {
                <TagChip @key="tag.Id"
                         Tag="tag"
                         Selected="SelectedTagIds.Contains(tag.Id)"
                         OnToggle="() => OnToggleTag.InvokeAsync(tag.Id)"
                         OnEdit="() => StartEdit(tag)"
                         OnDelete="() => OnDeleteTag.InvokeAsync(tag.Id)" />
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;
    [Parameter] public List<TagDto> Tags { get; set; } = [];
    [Parameter] public HashSet<long> SelectedTagIds { get; set; } = [];
    [Parameter] public bool Saving { get; set; }

    [Parameter] public EventCallback<long> OnToggleTag { get; set; }

    /// <summary>Receives the new tag; the parent validates and saves it.</summary>
    [Parameter] public EventCallback<NewTagForm> OnAddTag { get; set; }

    /// <summary>Saves a renamed or recoloured tag; true on success.</summary>
    [Parameter] public Func<TagEdit, Task<bool>> OnUpdateTag { get; set; } = _ => Task.FromResult(false);
    [Parameter] public EventCallback<long> OnDeleteTag { get; set; }

    private bool showForm;
    private long? editingId;
    private NewTagForm newTag = new();

    private void ToggleForm()
    {
        showForm = !showForm;
        editingId = null;
        newTag = new NewTagForm();
    }

    private void StartEdit(TagDto tag)
    {
        editingId = tag.Id;
        newTag = NewTagForm.From(tag);
        showForm = true;
    }

    private async Task SubmitAsync()
    {
        bool saved;

        if (editingId is { } id)
        {
            saved = await OnUpdateTag(new TagEdit(id, newTag));
        }
        else
        {
            var countBefore = Tags.Count;
            await OnAddTag.InvokeAsync(newTag);

            // Close the form only when the tag was actually created.
            saved = Tags.Count > countBefore;
        }

        if (saved)
        {
            newTag = new NewTagForm();
            editingId = null;
            showForm = false;
        }
    }
}
