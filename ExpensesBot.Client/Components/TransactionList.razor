<SearchFilterBar SearchText="@searchText"
                 CategoryId="Filter.CategoryId"
                 SortOrder="@Filter.Sort"
                 Categories="Categories"
                 Tags="Tags"
                 SelectedTagIds="Filter.Tags.ToHashSet()"
                 Disabled="Saving"
                 OnSearchChanged="SearchChangedAsync"
                 OnCategoryChanged="id => ApplyAsync(Filter with { CategoryId = id })"
                 OnSortChanged="order => ApplyAsync(Filter with { Sort = order })"
                 OnTagToggled="ToggleTagFilterAsync"
                 OnTagsCleared="() => ApplyAsync(Filter with { TagIds = [] })" />

<section class="history">
    <div class="history__heading">
        <h2>@T.History</h2>
        <button type="button" class="btn-icon-textless btn-icon-textless--primary" disabled="@Saving" @onclick="OnRefresh">@T.Refresh</button>
    </div>

    @if (Transactions.Count == 0 && Filter.IsFiltered)
    {
        <EmptyState Icon="🔍" Title="@T.NothingFound">
            <p>@T.ChangeSearch</p>
        </EmptyState>
    }
    else if (Transactions.Count == 0)
    {
        <EmptyState Icon="🧾" Title="@T.Empty">
            <p>@T.HistoryEmpty</p>
        </EmptyState>
    }
    else
    {
        @foreach (var transaction in Transactions)
        {
            var name = transaction.CategoryName ?? T.NoCategory;
            var occurredAt = T.DateTime(transaction.OccurredAtUtc.ToLocalTime());
            <article class="transaction-row" @key="transaction.Id">
                <div class="transaction-row__icon">@Categories.IconFor(transaction.CategoryId)</div>
                <div class="transaction-row__info">
                    <strong>@name</strong>
                    <div class="transaction-row__note">
                        @if (WalletName(transaction) is { } walletName)
                        {
                            <span class="badge badge--pill">👥 @walletName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(transaction.Note))
                        {
                            <span>@transaction.Note · </span>
                        }
                        <span class="transaction-row__date">@occurredAt</span>
                    </div>
                </div>
                <div class="transaction-row__side">
                    @if (TagsOf(transaction) is { Count: > 0 } transactionTags)
                    {
                        <div class="tag-list tag-list--compact">
                            @foreach (var tag in transactionTags)
                            {
                                <TagChip Tag="tag" />
                            }
                        </div>
                    }
                    <div class="transaction-row__amount-row">
                        <strong class="transaction-row__amount @(transaction.Type == TransactionType.Income ? "transaction-row__amount--income" : null)">
                            @Money.FormatSigned(transaction.AmountMinor, transaction.Currency, transaction.Type)
                        </strong>
                        @if (Convert(transaction) is { } converted)
                        {
                            <span class="transaction-row__converted">~@Money.Format(converted) @SelectedCurrency</span>
                        }
                        <button type="button" class="btn-icon-textless" title="@T.Edit" @onclick="() => OnEdit.InvokeAsync(transaction)">✏️</button>
                        <button type="button" class="btn-icon-textless btn-icon-textless--danger" title="@T.Delete" @onclick="() => ConfirmAndDeleteAsync(transaction.Id, name)">✕</button>
                    </div>
                </div>
            </article>
        }

        @if (HasMore)
        {
            <button type="button" class="btn btn--secondary history__more" disabled="@LoadingMore" @onclick="OnLoadMore">
                @(LoadingMore ? T.Loading : T.ShowMore)
            </button>
        }
    }
</section>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;

    /// <summary>The pages loaded so far, already filtered and sorted by the API.</summary>
    [Parameter] public List<TransactionDto> Transactions { get; set; } = [];

    /// <summary>The filter the parent loaded <see cref="Transactions"/> with.</summary>
    [Parameter] public HistoryFilter Filter { get; set; } = new();

    /// <summary>More transactions match the filter than are loaded.</summary>
    [Parameter] public bool HasMore { get; set; }
    [Parameter] public bool LoadingMore { get; set; }
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];
    [Parameter] public List<TagDto> Tags { get; set; } = [];

    /// <summary>The user's shared wallets, to label transactions recorded into one.</summary>
    [Parameter] public List<WalletDto> Wallets { get; set; } = [];
    [Parameter] public IReadOnlyList<ExchangeRateDto> Rates { get; set; } = [];
    [Parameter] public string SelectedCurrency { get; set; } = "AMD";
    [Parameter] public bool Saving { get; set; }

    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<TransactionDto> OnEdit { get; set; }
    [Parameter] public EventCallback<long> OnDelete { get; set; }

    /// <summary>Raised with the new filter; the parent reloads the first page with it.</summary>
    [Parameter] public EventCallback<HistoryFilter> OnFilterChanged { get; set; }
    [Parameter] public EventCallback OnLoadMore { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    /// <summary>Typing waits this long for a pause before asking the API.</summary>
    public static readonly TimeSpan SearchDelay = TimeSpan.FromMilliseconds(300);

    private string searchText = "";
    private CancellationTokenSource? pendingSearch;

    // The list is re-created when its tab is opened again: show the search it was left with.
    protected override void OnInitialized() => searchText = Filter.Search;

    protected override async Task OnParametersSetAsync()
    {
        // Tags deleted since the filter was set no longer restrict anything.
        if (Filter.Tags.Any(id => Tags.All(tag => tag.Id != id)))
            await ApplyAsync(Filter with { TagIds = Filter.Tags.Where(id => Tags.Any(tag => tag.Id == id)).ToList() });
    }

    private async Task SearchChangedAsync(string text)
    {
        searchText = text;

        pendingSearch?.Cancel();
        pendingSearch = new CancellationTokenSource();
        var token = pendingSearch.Token;

        try
        {
            await Task.Delay(SearchDelay, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await ApplyAsync(Filter with { Search = text });
    }

    private Task ToggleTagFilterAsync(long tagId)
    {
        var tags = Filter.Tags.Contains(tagId)
            ? Filter.Tags.Where(id => id != tagId).ToList()
            : [.. Filter.Tags, tagId];

        return ApplyAsync(Filter with { TagIds = tags });
    }

    private Task ApplyAsync(HistoryFilter filter) => OnFilterChanged.InvokeAsync(filter);

    private string? WalletName(TransactionDto transaction) =>
        transaction.WalletId is { } walletId
            ? Wallets.FirstOrDefault(w => w.Id == walletId)?.Name ?? T.SharedWallet
            : null;

    private List<TagDto> TagsOf(TransactionDto transaction) =>
        transaction.TransactionTags is { Count: > 0 } links
            ? Tags.Where(tag => links.Any(link => link.TagId == tag.Id)).ToList()
            : [];

    /// <summary>Approximate amount in the display currency, using the rates served by the API.</summary>
    private long? Convert(TransactionDto transaction)
    {
        if (transaction.Currency == SelectedCurrency)
            return null;

        var rate = Rates.FirstOrDefault(r => r.FromCurrency == transaction.Currency && r.ToCurrency == SelectedCurrency);
        return rate is null
            ? null
            : (long)Math.Round(transaction.AmountMinor * rate.Rate, MidpointRounding.AwayFromZero);
    }

    private async Task ConfirmAndDeleteAsync(long id, string name)
    {
        if (await JS.ConfirmAsync(T.ConfirmDeleteTransaction(name)))
            await OnDelete.InvokeAsync(id);
    }
}
