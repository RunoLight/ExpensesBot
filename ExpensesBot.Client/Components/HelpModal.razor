<Modal Title="@($"❔ {T.Help}")" Wide="true" OnClose="OnClose">
    <ChildContent>
        @if (T.IsRussian)
        {
            <HelpContentRu />
        }
        else
        {
            <HelpContentEn />
        }
    </ChildContent>
    <Actions>
        <button type="button" class="btn btn--secondary" @onclick="OnClose">@T.GotIt</button>
    </Actions>
</Modal>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;
    [Parameter] public EventCallback OnClose { get; set; }
}
