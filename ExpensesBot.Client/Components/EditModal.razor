<Modal Title="@(Form.Type == TransactionType.Income ? "Редактировать доход" : "Редактировать расход")" OnClose="OnClose">
    <EditForm Model="Form" OnValidSubmit="OnSave">
        <TypeToggle @bind-Value="Form.Type" />

        <div class="form-row">
            <div class="form-group">
                <label for="edit-amount">Сумма</label>
                <InputNumber id="edit-amount" class="form-control" @bind-Value="Form.Amount" />
            </div>
            <div class="form-group">
                <label for="edit-currency">Валюта</label>
                <CurrencySelect Id="edit-currency" @bind-Value="Form.Currency" />
            </div>
        </div>

        <label for="edit-category">Категория</label>
        <CategorySelect Id="edit-category" Categories="Categories" @bind-Value="Form.CategoryId" />

        <label for="edit-note">Комментарий</label>
        <InputText id="edit-note" class="form-control" @bind-Value="Form.Note" placeholder="Комментарий" />

        <div class="modal-card__actions">
            <button class="btn btn--primary" type="submit" disabled="@Saving">Сохранить</button>
            <button class="btn btn--secondary" type="button" @onclick="OnClose">Отмена</button>
        </div>
    </EditForm>
</Modal>

@code {
    /// <summary>
    /// Form state owned by the parent page. The parent reads these values when
    /// <see cref="OnSave"/> fires, so the modal binds to this instance
    /// rather than keeping a private copy.
    /// </summary>
    [Parameter, EditorRequired] public TransactionFormModel Form { get; set; } = new();

    [Parameter] public List<CategoryDto> Categories { get; set; } = [];
    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
