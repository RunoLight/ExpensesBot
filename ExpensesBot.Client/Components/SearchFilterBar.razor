<section class="panel filter-bar">
    <div class="filter-bar__search">
        <span class="filter-bar__icon">🔍</span>
        <input class="form-control"
               value="@SearchText"
               @oninput="e => OnSearchChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
               placeholder="@T.SearchPlaceholder" />
    </div>
    <CategorySelect Categories="Categories"
                    IncludeArchived="true"
                    EmptyLabel="@T.AllCategories"
                    Value="CategoryId"
                    ValueChanged="OnCategoryChanged" />
    <select class="form-control" value="@SortOrder" @onchange="e => OnSortChanged.InvokeAsync(e.Value?.ToString() ?? DefaultSort)">
        @foreach (var (value, label) in SortOptions())
        {
            <option value="@value">@label</option>
        }
    </select>
    @if (Tags.Count > 0)
    {
        <div class="filter-bar__tags">
            <span class="field-label">@T.TagsLabel</span>
            @foreach (var tag in Tags)
            {
                <TagChip @key="tag.Id"
                         Tag="tag"
                         Selected="SelectedTagIds.Contains(tag.Id)"
                         OnToggle="() => OnTagToggled.InvokeAsync(tag.Id)" />
            }
            @if (SelectedTagIds.Count > 0)
            {
                <button type="button" class="btn-icon-textless btn-icon-textless--secondary" title="@T.ClearTags" @onclick="OnTagsCleared">@T.Clear</button>
            }
        </div>
    }
    <button type="button" class="btn btn--secondary" disabled="@Disabled" @onclick="OnExport">@T.ExportCsv</button>
</section>

@code {
    public const string DefaultSort = HistoryFilter.DefaultSort;

    [CascadingParameter] public UiText T { get; set; } = UiText.En;

    private (string Value, string Label)[] SortOptions() =>
    [
        (DefaultSort, T.NewestFirst),
        ("date-asc", T.OldestFirst),
        ("amount-desc", T.AmountDesc),
        ("amount-asc", T.AmountAsc),
        ("name-asc", T.CategoryAz),
        ("name-desc", T.CategoryZa)
    ];

    [Parameter] public string SearchText { get; set; } = "";
    [Parameter] public long? CategoryId { get; set; }
    [Parameter] public string SortOrder { get; set; } = DefaultSort;
    [Parameter] public List<CategoryDto> Categories { get; set; } = [];
    [Parameter] public List<TagDto> Tags { get; set; } = [];
    [Parameter] public IReadOnlySet<long> SelectedTagIds { get; set; } = new HashSet<long>();
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public EventCallback<long?> OnCategoryChanged { get; set; }
    [Parameter] public EventCallback<string> OnSortChanged { get; set; }

    /// <summary>A tag chip was tapped: select it, or unselect it if it was selected.</summary>
    [Parameter] public EventCallback<long> OnTagToggled { get; set; }
    [Parameter] public EventCallback OnTagsCleared { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
}
