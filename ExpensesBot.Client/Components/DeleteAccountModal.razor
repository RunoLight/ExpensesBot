<Modal Title="@T.DeleteAccountTitle" OnClose="OnClose">
    <ChildContent>
        <p>@T.DeleteAccountQuestion</p>
        <p class="warning-text">@T.CannotBeUndone</p>
        <label for="delete-confirm-input">@T.TypeToConfirmBefore <code>@ConfirmWord</code> @T.TypeToConfirmAfter</label>
        <input id="delete-confirm-input" class="form-control" placeholder="@ConfirmWord" @bind="confirmText" @bind:event="oninput" />
    </ChildContent>
    <Actions>
        <button class="btn btn--primary btn--danger" type="button" disabled="@(Saving || confirmText != ConfirmWord)" @onclick="OnConfirm">@T.DeleteAccount</button>
        <button class="btn btn--secondary" type="button" @onclick="OnClose">@T.Cancel</button>
    </Actions>
</Modal>

@code {
    [CascadingParameter] public UiText T { get; set; } = UiText.En;

    private string ConfirmWord => T.ConfirmWord;

    [Parameter] public bool Saving { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string confirmText = "";
}
